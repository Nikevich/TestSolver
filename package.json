{
  "name": "testsolver",
  "version": "1.0.1",
  "description": "Local test solver: reads questions from the built-in browser and answers them with Ollama or opencode",
  "main": "src/main/main.js",
  "author": {
    "name": "Shkilevich Nikita",
    "email": "nik.shkilevich3@gmail.com"
  },
  "homepage": "https://github.com/Nikevich/TestSolver",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nikevich/TestSolver.git"
  },
  "bugs": {
    "url": "https://github.com/Nikevich/TestSolver/issues"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron scripts/smoke.js",
    "test:adapters": "node scripts/test-adapters.js",
    "icon": "node scripts/make-icon.js",
    "screenshot": "electron scripts/screenshot.js",
    "source:archive": "node scripts/source-archive.js",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:all": "electron-builder --win nsis portable --linux AppImage deb --publish never"
